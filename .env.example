# Copy this file to .env.local and fill in your real values.
# Get a Riot API key from https://developer.riotgames.com
# NEVER commit .env.local with your real keys.

RIOT_API_KEY=YOUR_DEVELOPMENT_KEY_HERE

# Platform/region routing for the Riot API.
# Platform host examples: kr, na1, euw1, jp1 ...
# Regional host examples: asia, americas, europe
RIOT_PLATFORM=kr
RIOT_REGION=asia

# Database (used by docker-compose)
DB_HOST=db
DB_PORT=3306
DB_USER=cmjeon
DB_PASSWORD=cmjeon
DB_NAME=lolclient
DB_ROOT_PASSWORD=rootpass

# Default admin account password (change after first login!)
DEFAULT_ADMIN_PASSWORD=1234

# 내전 전용 관람 계정 비밀번호 (없으면 계정이 생성되지 않습니다)
SCRIM_ONLY_PASSWORD=your-scrim-only-password-here

# 세션 서명 키 — 반드시 충분히 긴 랜덤 문자열로 설정하세요.
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 프로덕션에서 이 값이 없으면 서버가 시작되지 않습니다.
SESSION_SECRET=your-random-secret-here

# Discord 봇 서버 URL
DISCORD_BOT_URL=http://localhost:8354
